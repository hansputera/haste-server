[Unit]
Description=Haste pastebin
Documentation=https://github.com/seejohnrun/haste-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=haste
Group=haste
WorkingDirectory=/opt/haste

# Configuration comes from the environment, not from a config.js. An empty
# HASTE_CONFIG tells the app there is no file layer at all.
Environment=HASTE_CONFIG=
EnvironmentFile=-/etc/haste.env

ExecStart=/usr/bin/node --enable-source-maps /opt/haste/dist/server.js

# Restart on any exit, with a pause so a crash loop cannot spin the CPU.
Restart=always
RestartSec=2s
TimeoutStopSec=20s
KillSignal=SIGTERM

# 2 vCPU / 2 GiB: cap the service so a pathological paste cannot take the box.
MemoryMax=768M
MemoryHigh=512M
CPUQuota=150%
TasksMax=256

# `/var/lib/haste` must exist and be owned by haste:haste before the unit
# starts: ReadWritePaths cannot create it, and with PrivateTmp the path is
# resolved in the unit's own mount namespace.
ReadWritePaths=/var/lib/haste
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
NoNewPrivileges=yes
# Drop every capability except those needed to bind a normal port and read
# files. `CapabilityBoundingSet=` (empty) is deliberately not used: it requires
# the unit to start as root and is rejected outright for a user service.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SystemCallArchitectures=native
UMask=0027

StandardOutput=journal
StandardError=journal
SyslogIdentifier=haste

[Install]
WantedBy=multi-user.target
