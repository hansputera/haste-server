{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "builds": [{ "src": "api/index.ts", "use": "@vercel/node" }],
  "routes": [{ "src": "/(.*)", "dest": "api/index.js" }],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": ["static/**", "openapi.json", "about.md"]
    }
  }
}
