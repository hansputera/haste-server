{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": "static",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "{static/**,openapi.json,about.md}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
