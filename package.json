{
  "name": "haste",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Private Pastebin Server",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hansputera/haste-server.git"
  },
  "bugs": {
    "url": "https://github.com/hansputera/haste-server/issues"
  },
  "homepage": "https://github.com/hansputera/haste-server#readme",
  "keywords": [
    "paste",
    "pastebin"
  ],
  "author": {
    "name": "John Crepezzi",
    "email": "john.crepezzi@gmail.com",
    "url": "http://seejohncode.com/"
  },
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/netlify": "^1.0.2",
    "@hono/node-server": "^2.1.8",
    "@hono/vercel": "^1.0.1",
    "busboy": "^1.6.0",
    "express-rate-limit": "^8.7.4",
    "hono": "^4.13.18",
    "pg": "^8.0.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.2"
  },
  "bundledDependencies": [],
  "bin": {
    "haste-server": "./dist/server.js"
  },
  "files": [
    "dist",
    "static"
  ],
  "directories": {
    "lib": "./dist"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node scripts/precompress.js && node scripts/copy-assets.mjs",
    "prestart": "npm run build",
    "serve": "node dist/server.js",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "dev:bun": "bun --watch src/server.ts",
    "start:bun": "bun src/server.ts",
    "test": "npm run build && node scripts/run-tests.mjs",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "check:openapi": "node scripts/check-openapi.mjs",
    "commitlint": "commitlint --edit",
    "gen:config-docs": "node scripts/gen-config-docs.mjs",
    "check:config-docs": "node scripts/gen-config-docs.mjs --check"
  },
  "bundleDependencies": [],
  "forkOf": "seejohnrun/haste-server"
}
