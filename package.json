{
  "name": "haste",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @haste/api build && pnpm --filter @haste/web build",
    "check": "pnpm --filter @haste/api check && pnpm --filter @haste/web check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "test": "pnpm --filter @haste/api test",
    "dev": "pnpm --filter @haste/api dev",
    "start": "pnpm --filter @haste/api start",
    "check:openapi": "pnpm --filter @haste/api check:openapi",
    "check:config-docs": "pnpm --filter @haste/api check:config-docs",
    "check:highlight": "pnpm --filter @haste/api check:highlight",
    "check:font": "pnpm --filter @haste/api check:font",
    "check:deploy": "pnpm --filter @haste/api check:deploy",
    "gen:config-docs": "pnpm --filter @haste/api gen:config-docs",
    "gen:highlight": "pnpm --filter @haste/api gen:highlight",
    "gen:font": "pnpm --filter @haste/api gen:font",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.72.2"
  }
}
